{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/codex-token-meter.js\" ensure-web --focus",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/codex-token-meter.js\" ensure-web --focus",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
